# Docs - at least in some branches - contains the WebFormatter build.  Blazor
# includes hashes for those files, and Git's helpful EOL conversions cause
# tons of havok.
docs/** binary

# Large benchmark data files → Git LFS
benchmarks/**/Data/*.json   filter=lfs diff=lfs merge=lfs -text
benchmarks/**/Data/*.jsonc  filter=lfs diff=lfs merge=lfs -text
