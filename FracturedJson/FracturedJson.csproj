<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Nullable>enable</Nullable>
        <Title>FracturedJson</Title>
        <Description>JSON/JSONC formatter that produces compact, readable output — inline when simple, table-aligned when similar, wrapped when long.</Description>
        <PackageTags>json jsonc formatter pretty-print prettyprint beautify beautifier json-formatter compact readable table alignment comments dotnet</PackageTags>
        <Copyright>2026 Jesse Brooke</Copyright>
        <PackageProjectUrl>https://j-brooke.github.io/FracturedJson/</PackageProjectUrl>
        <RepositoryUrl>https://github.com/j-brooke/FracturedJson</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryType>git</RepositoryType>
        <AssemblyVersion>5.1.0</AssemblyVersion>
        <PackageVersion>5.1.0</PackageVersion>
        <PackageIcon>packageIcon.png</PackageIcon>
        <LangVersion>10</LangVersion>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <DocumentationFile>bin\Release\netstandard2.0\FracturedJson.xml</DocumentationFile>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <DocumentationFile>bin\Debug\netstandard2.0\FracturedJson.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../packageIcon.png" Pack="true" PackagePath="" />
        <None Include="README.md" Pack="true" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="System.Text.Json" Version="10.0.10" />
    </ItemGroup>
</Project>
